{
  "name": "ecommerce-server",
  "version": "1.0.0",
  "description": "Backend API for an e-commerce platform built with Node.js, Express, PostgreSQL, TypeScript, and other modern backend technologies. ",
  "keywords": [
    "ecommerce",
    "express",
    "typescript",
    "node",
    "zod"
  ],
  "homepage": "https://github.com/ProgramadorXP/E-commerce_Backend#readme",
  "bugs": {
    "url": "https://github.com/ProgramadorXP/E-commerce_Backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProgramadorXP/E-commerce_Backend.git"
  },
  "license": "ISC",
  "author": "Jonhatan Villalobos Parra",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint 'src/**/*.ts'",
    "test": "jest --detectOpenHandles",
    "prepare": "cd .. && husky server/.husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.2.0",
    "@prisma/client": "7.2.0",
    "argon2": "0.44.0",
    "chalk": "5.6.2",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.10.1",
    "pg": "8.16.3",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "winston": "3.19.0",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "25.0.3",
    "@types/pg": "8.16.0",
    "@types/supertest": "6.0.3",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.39.2",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "lint-staged": "16.2.7",
    "prettier": "3.7.4",
    "prisma": "7.2.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
